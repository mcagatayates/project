# Bu dosyayı .env olarak kopyalayıp kendi değerlerinizi girin:
#   cp .env.example .env
# .env dosyasını ASLA git'e commitlemeyin (zaten .gitignore içinde).

# --- Pinterest Developer uygulaması (developers.pinterest.com) ---
# Trial erişim (varsayılan, günde 1000 istek) bu proje için yeterlidir,
# Standard'a yükseltmeye gerek yoktur. Detaylar için README'ye bakın.
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Pinterest uygulama ayarlarında tanımladığınız yönlendirme adresi
# (gerçek bir sunucu olması gerekmez, örn. https://localhost/callback)
PINTEREST_REDIRECT_URI=https://localhost/callback
# authorize.py çalıştırdıktan sonra buraya yapıştırın (ilk kurulum
# tohumu; script sonrasında güncel token'ı state/token_cache.json
# içinde kendisi takip eder).
PINTEREST_REFRESH_TOKEN=

# --- Marka / pin görseli şablonu ---
BRAND_NAME=Marka Adınız
# Varsa logo dosyası yolu (PNG, şeffaf arka plan önerilir). Boşsa
# alt bantta sadece BRAND_NAME metni yazılır.
LOGO_PATH=
# İsteğe bağlı özel TrueType (.ttf) font yolu. Boş bırakılırsa sistemde
# bulunan DejaVu Sans (Bold) kullanılır, o da yoksa PIL'in düşük kaliteli
# varsayılan fontuna düşülür.
FONT_PATH=

# --- Paylaşım hızı / zamanlama ---
# Günde en fazla kaç pin paylaşılsın (Pinterest spam politikalarına
# takılmamak için 3-5 arası önerilir).
DAILY_PIN_LIMIT=4
# İki paylaşım arasında en az kaç dakika beklensin.
MIN_MINUTES_BETWEEN_PINS=180

# --- Dosya yolları (varsayılanlar genelde yeterlidir) ---
CSV_PATH=urunler.csv
OUTPUT_DIR=pinler
LOG_PATH=log.txt
