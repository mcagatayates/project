# ---------------------------------------------------------------------------
# Etsy -> Logo Isbasi Invoicing Automation - environment configuration
# Copy to .env and fill in real values. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
NODE_ENV=development

# --- Database (PostgreSQL / Prisma) ---
DATABASE_URL=postgresql://etsy_invoicing:etsy_invoicing@localhost:5432/etsy_invoicing?schema=public

# --- Encryption for raw email payloads at rest (32-byte key, base64) ---
# Generate with: openssl rand -base64 32
PAYLOAD_ENCRYPTION_KEY=

# --- Admin panel auth (HTTP Basic) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Gmail API OAuth2 (mail-provider: gmail adapter) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/oauth2/gmail/callback
GMAIL_REFRESH_TOKEN=
# Search query used to find new Etsy order emails. See README for guidance.
ETSY_MAIL_QUERY=from:transaction@etsy.com subject:"You made a sale"
# Gmail label applied ONLY after an invoice has been successfully created.
GMAIL_PROCESSED_LABEL=Etsy-Invoiced
# Polling interval for the job worker, in seconds.
MAIL_POLL_INTERVAL_SECONDS=120

# --- Etsy Open API v3 (optional cross-validation against email data) ---
# Leave all four empty to run in EMAIL_ONLY mode.
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_ACCESS_TOKEN=
ETSY_SHOP_ID=

# --- Logo Isbasi integration ---
# NOTE: docs/logo-isbasi-api/ was not present in this repository at
# implementation time, so the REAL Logo client is an intentionally blocked
# stub (see src/logo-isbasi-client/RealLogoIsbasiClient.ts). Until official
# API docs are added and the real client is implemented, LOGO_BASE_URL should
# stay empty so the system falls back to MockLogoClient (safe, non-network).
LOGO_BASE_URL=
LOGO_API_KEY=
LOGO_CLIENT_ID=
LOGO_CLIENT_SECRET=
LOGO_COMPANY_ID=
LOGO_DEFAULT_PRODUCT_CODE=
LOGO_INVOICE_SCENARIO=
LOGO_INVOICE_PROFILE=
LOGO_EXCEPTION_CODE=
LOGO_EXCEPTION_DESCRIPTION=

# --- Invoice policy / safety ---
# Real, formalized invoices are NEVER created unless every one of these
# conditions holds. See SECURITY.md.
AUTO_FINALIZE_INVOICE=false
ACCOUNTING_RULES_APPROVED=false
AMOUNT_TOLERANCE=0.01

# --- Retry / backoff ---
MAX_RETRY_ATTEMPTS=5
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=60000
