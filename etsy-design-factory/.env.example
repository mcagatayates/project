# Copy to .env and fill in real values. Never commit a real .env file.
# See docs/PROVIDER_ARCHITECTURE.md and docs/DATABASE.md for what each
# value controls.

# --- Core ---
APP_ENV=development            # development | test | production
PROVIDER_MODE=fake             # "fake" forces every provider role to the deterministic fake adapter (no paid calls)

# --- Database (PostgreSQL is the source of truth, see docs/DATABASE.md) ---
DATABASE_URL=postgresql+psycopg2://design_factory:CHANGE_ME@postgres:5432/design_factory

# --- Queue (Redis broker/result backend, see docs/EVENTS.md) ---
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_RETRY_BACKOFF_MAX=600
CELERY_MAX_RETRIES=5

# --- Storage (S3-compatible; local filesystem also supported for dev) ---
STORAGE_BACKEND=local           # local | s3 | gdrive
STORAGE_LOCAL_ROOT=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Budgets (see docs/AGENT_CONTRACTS.md "Daily Production Controller") ---
DAILY_BUDGET_USD=150.0
MONTHLY_BUDGET_USD=3500.0
PER_DESIGN_BUDGET_USD=3.0

# --- Provider API keys (only needed once a real adapter is implemented and
#     wired in config/providers.yaml -- see docs/ROADMAP.md "Explicit
#     non-goals"; none are required to run the system in fake mode) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
TOPAZ_API_KEY=

# --- Etsy integration (isolated from the creative pipeline; only needed
#     for app/pipeline/performance_ingestion.py and real publishing) ---
ETSY_API_KEY=
ETSY_API_SECRET=
ETSY_SHOP_ID=
ETSY_OAUTH_TOKEN=

# --- Market Intelligence (see app/pipeline/market_intelligence.py) ---
# Code-level adapter: set to enable app/providers/web_search_market_intelligence.py
# (queries SerpAPI directly from a Celery worker). Leave unset to rely only
# on the ingestion API below (e.g. an agent-driven research job) -- the
# system never fabricates a trend when neither is configured.
SERPAPI_KEY=
# Shared secret required on POST /api/market-intelligence/signals. That
# endpoint lets an out-of-process caller write data that later influences
# real production decisions; leaving this unset is fine for local/dev use
# but any deployment reachable by more than your own research job should
# set it.
MARKET_SIGNAL_INGESTION_TOKEN=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

LOG_LEVEL=INFO
